# Clear the emulation
i @

# Create the machine and name it 's32k'
mach create "s32k"
machine LoadPlatformDescription @scripts/s32k144.repl

# Load the binary
sysbus LoadELF @firmware/vulnerable.elf

# Log UART output to the Renode log so we can debug if needed
sysbus.lpuart0 CreateExecutionTracing "uart-trace"
